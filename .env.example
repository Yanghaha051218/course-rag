# Backend settings
COURSE_RAG_APP_NAME=CourseRAG API
COURSE_RAG_ENVIRONMENT=development
COURSE_RAG_DATABASE_PATH=runtime/db/course-rag.sqlite3
COURSE_RAG_QDRANT_PATH=runtime/qdrant
COURSE_RAG_UPLOAD_PATH=runtime/uploads
COURSE_RAG_QDRANT_COLLECTION_PREFIX=course_rag
COURSE_RAG_EMBEDDING_PROVIDER=deterministic
COURSE_RAG_EMBEDDING_BATCH_SIZE=64
COURSE_RAG_CHUNK_TARGET_SIZE=600
COURSE_RAG_CHUNK_OVERLAP=100
COURSE_RAG_MAX_DOCUMENT_BYTES=52428800

# Optional OpenAI embedding provider settings. Never commit a real key.
# COURSE_RAG_EMBEDDING_PROVIDER=openai
# COURSE_RAG_EMBEDDING_MODEL=text-embedding-3-small
# COURSE_RAG_EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=

# Optional local semantic embedding provider. The first use downloads the
# explicitly selected model into this ignored cache; course text stays local.
# COURSE_RAG_EMBEDDING_PROVIDER=fastembed
# COURSE_RAG_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# COURSE_RAG_FASTEMBED_CACHE_DIR=runtime/models/fastembed

# Optional OpenAI support-verification settings. The verifier receives only the
# question and retrieved evidence after course isolation and provenance checks.
COURSE_RAG_VERIFIER_PROVIDER=openai
COURSE_RAG_VERIFIER_MODEL=gpt-4o-mini

# Optional OpenAI grounded-generation settings. The generator receives only
# evidence chunks that the Support Verifier explicitly bound as SUPPORTED.
COURSE_RAG_GENERATOR_PROVIDER=openai
COURSE_RAG_GENERATOR_MODEL=gpt-4o-mini

# Reserved for future browser-to-API requests.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
